# Claude Hotmail Connector — environment template (development).
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).
# Installed builds don't need this: `setup --client-id <id>` saves the client id.

# ── Required: your own app registration ──────────────────────────────────────
# Application (client) ID of YOUR Microsoft Entra app registration (a PUBLIC /
# native client; see "Register a Microsoft Entra application" in the README or
# scripts/register-app.ps1). No shared id is bundled. No client secret is used:
# public clients use PKCE. If unset, the id saved by `setup --client-id` is used.
MICROSOFT_CLIENT_ID=

# ── Optional (sensible defaults shown) ───────────────────────────────────────
# Tenant segment. `consumers` (default) = personal Microsoft accounts only
# (hotmail/outlook/live). `common` also allows work/school accounts, and needs a
# multitenant + personal app registration.
MICROSOFT_TENANT=consumers

# Default IANA time zone for calendar reads and writes.
DEFAULT_TIMEZONE=Australia/Brisbane

# Space- or comma-separated delegated Graph scopes. Leave unset to use the
# least-privilege default:
#   openid profile email offline_access User.Read Mail.Read Calendars.ReadWrite
# NARROWING ONLY: you may drop scopes, or use Calendars.Read instead of
# Calendars.ReadWrite (read-only calendar). Anything broader is rejected.
# openid + offline_access are always added; tools needing a dropped scope are
# hidden. Example (mail + read-only calendar):
#   MICROSOFT_SCOPES=User.Read Mail.Read Calendars.Read
# MICROSOFT_SCOPES=

# Log verbosity: debug | info | warn | error. Logs go to stderr only.
LOG_LEVEL=info

# Override the directory for the encrypted token cache (and settings.json).
# Defaults to %LOCALAPPDATA%\claude-hotmail-connector on Windows, else
# ~/.claude-hotmail-connector.
# CLAUDE_HOTMAIL_CACHE_DIR=
