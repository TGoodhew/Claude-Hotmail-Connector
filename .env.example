# Claude Hotmail Connector — environment template (development).
# Copy to `.env` in the repository root and fill in. It is read ONLY from there
# (never from the directory the server is launched in). NEVER commit the real
# .env (it is git-ignored).
# The Claude Desktop extension doesn't use this file: enter the client id in its settings.

# ── Required: your own app registration ──────────────────────────────────────
# Application (client) ID of YOUR Microsoft Entra app registration (a PUBLIC /
# native client; see "Step 1: register your own Microsoft Entra application" in the README or
# scripts/register-app.ps1). No shared id is bundled. No client secret is used:
# public clients use PKCE.
MICROSOFT_CLIENT_ID=

# ── Optional (sensible defaults shown) ───────────────────────────────────────
# Tenant segment. `consumers` (default) = personal Microsoft accounts only
# (hotmail/outlook/live). `common` also allows work/school accounts, and needs a
# multitenant + personal app registration.
MICROSOFT_TENANT=consumers

# IANA time zone for calendar calls that don't name one. Leave unset to use
# this computer's time zone (UTC if it can't be read). Checked at startup.
# DEFAULT_TIMEZONE=Europe/London

# Space- or comma-separated delegated Graph scopes. Leave unset to use the
# least-privilege default:
#   openid profile email offline_access User.Read Mail.Read Calendars.ReadWrite
# NARROWING ONLY: you may drop scopes, or use Calendars.Read instead of
# Calendars.ReadWrite (read-only calendar). Anything broader is rejected.
# openid + offline_access are always added; tools needing a dropped scope are
# hidden. Example (mail + read-only calendar):
#   MICROSOFT_SCOPES=User.Read Mail.Read Calendars.Read
# MICROSOFT_SCOPES=

# Sending mail (off by default). true lets Claude send emails and replies; each
# one is shown to you in your browser and sent only when you click Send there.
# Adds the Mail.Send scope, so sign in again after turning it on.
# ALLOW_SEND_MAIL=false

# Log verbosity: debug | info | warn | error. Logs go to stderr (and to the log
# file below, if it's on).
LOG_LEVEL=info

# Also write the logs to connector.log in the cache directory (off by default).
# Same redacted lines as stderr; never more than 2 MB (the older half is cut).
# LOG_FILE=false

# Override the directory for the encrypted token cache (and the log file).
# Defaults to %LOCALAPPDATA%\claude-hotmail-connector on Windows; elsewhere
# $XDG_STATE_HOME/claude-hotmail-connector if XDG_STATE_HOME is set, else
# ~/.claude-hotmail-connector.
# CLAUDE_HOTMAIL_CACHE_DIR=
