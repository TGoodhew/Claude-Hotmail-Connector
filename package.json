{
  "name": "claude-hotmail-connector",
  "version": "1.0.0",
  "description": "Local (stdio) MCP server and Claude Desktop extension giving Claude email (read, plus opt-in sending you confirm) and read/write calendar access to your personal Microsoft account (Outlook.com / Hotmail / Live) via Microsoft Graph.",
  "license": "MIT",
  "author": "Tony Goodhew",
  "type": "module",
  "bin": {
    "claude-hotmail-connector": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/test-live.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^18.0.6",
    "open": "^11.0.4",
    "unpdf": "1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "ajv": {
        "fast-uri": "3.1.8"
      },
      "express-rate-limit": {
        "ip-address": "10.7.4"
      },
      "@hono/node-server": "2.1.3"
    },
    "vitest": {
      "vite": "8.1.6"
    },
    "@anthropic-ai/mcpb": {
      "tmp": "0.2.7"
    }
  }
}
