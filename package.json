{
  "name": "claude-hotmail-connector",
  "version": "0.1.0",
  "description": "Local (stdio) MCP server giving Claude read-only email and read/write calendar access to your personal Microsoft account (Outlook.com / Hotmail / Live) via Microsoft Graph.",
  "license": "MIT",
  "author": "Tony Goodhew",
  "type": "module",
  "bin": {
    "claude-hotmail-connector": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "open": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.27.2",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "ajv": {
        "fast-uri": "3.1.8"
      },
      "express-rate-limit": {
        "ip-address": "10.7.3"
      },
      "@hono/node-server": "2.1.3"
    },
    "vitest": {
      "vite": "8.1.6"
    },
    "@anthropic-ai/mcpb": {
      "tmp": "0.2.7"
    }
  }
}
